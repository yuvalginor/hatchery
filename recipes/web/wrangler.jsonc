{
  // Static assets only: dist/ is uploaded and nothing else.
  // Add "main" when the project needs a Worker route (hatchery DECISION-TREE.md, rung 1).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-project",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  // Previews take settings from here, never from production. Point data bindings at preview resources.
  "previews": {}
}
