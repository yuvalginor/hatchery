{
  "name": "my-project",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "privacy": "node scripts/privacy-check.ts dist",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e && npm run privacy",
    "icons": "node scripts/icons.ts",
    "deploy": "node scripts/deploy.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
